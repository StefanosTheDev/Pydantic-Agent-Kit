# Required for the conversational agent and native web search.
OPENAI_API_KEY=

# Optional model override. It must support the OpenAI Responses API.
OPENAI_MODEL=openai-responses:gpt-4.1-mini

# Local PostgreSQL + pgvector started by docker compose.
DATABASE_URL=postgresql://kairos:kairos@127.0.0.1:54320/kairos

# Documents and questions must use the same embedding model and dimensions.
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional. Add a project write token to send agent traces to Logfire.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
